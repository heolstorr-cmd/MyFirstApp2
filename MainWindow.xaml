<Window x:Class="MyFirstApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyFirstApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="16">
            <TextBlock x:Name="lblWelcome"
Text="Добро пожаловать!"
FontSize="20"/>
            <TextBlock Text="Введите ваше имя:"/>
            <TextBox x:Name="txtName"/>
            <Button x:Name="BtnGreet"
Content="Поприветствовать" Click="BtnGreet_Click" />
            <Button x:Name="BtnOpen"
Content="Открыть второе окно" Click="BtnOpen_Click"/>
        </StackPanel>
    </Grid>
</Window>
